---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  # The file's own header is placed first automatically (IncludeIsMainRegex).
  - Regex: '^<pybind11/'
    Priority: 2
  - Regex: '^<(gtest|gmock|benchmark)/'
    Priority: 2
  - Regex: '^<[a-z_]+>$'
    Priority: 3
  - Regex: '^"voronav/'
    Priority: 4
  - Regex: '.*'
    Priority: 5
